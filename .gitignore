# =========================================================================
# ADEO Health Intelligence Pipeline - Full Stack Git Ignore
# =========================================================================

# --- React/Frontend ---
node_modules/
dist/
dist-ssr/
dist-frontend/
.parcel-cache
.cache
*.local
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python/Backend ---
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.Python
backend/env/
backend/venv/
backend/.venv/
backend/venv.bak/
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- ADEO Intelligence Data & Privacy ---
# NEVER commit raw or encrypted user data or keys
**/output/vault/
**/output/user_profiles/
**/output/goals/
**/output/rewards/
**/output/learning/
**/output/rag_memory/
**/output/models/
**/data/master.key
**/data/sync_queue.json
**/output/*.csv
**/output/*.npy
**/output/*.joblib

# Keep necessary descriptors but ignore generated content
!**/output/aggregation_daily.csv
!**/output/*_sample.csv
!**/output/models/.gitkeep
!**/output/rag_memory/.gitkeep

# --- Logs & Metadata ---
logs/
*.log
**/output/pipeline_logs.txt
**/output/data_quality_report.json
**/output/feature_descriptions.json
**/output/pipeline_results.json

# --- Editor & System ---
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
