# ─── ADEO Intelligence Data & Privacy ────────────────────────────────────────
# NEVER commit raw user data, profiles, or encryption keys
**/output/vault/
**/output/user_profiles/
**/output/goals/
**/output/rewards/
**/output/learning/
**/output/rag_memory/
**/output/models/
**/data/master.key
**/data/sync_queue.json

# Generated data files
**/output/*.csv
**/output/*.npy
**/output/*.joblib
**/output/*.pkl
**/output/*.h5
**/output/*.pt
**/output/*.onnx

# Keep placeholder files
!**/output/models/.gitkeep
!**/output/rag_memory/.gitkeep
!**/output/**/.gitkeep

# ─── Logs & Pipeline Artifacts ───────────────────────────────────────────────
logs/
*.log
log/
**/output/pipeline_logs.txt
**/output/data_quality_report.json
**/output/feature_descriptions.json
**/output/pipeline_results.json

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Don't commit local model weights or Ollama config
.ollama/
ollama_models/

# ─── Editor & IDEs ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Misc ────────────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
.sass-cache/

# ─── Frontend: New Architecture (Zustand / Framer Motion / D3) ────────────────
# Zustand devtools persisted state (browser IndexedDB exports)
zustand-devtools/

# Framer Motion layout animation snapshots (if exported)
*.framer-snapshot

# D3 generated SVG exports
*.d3export.svg

# Vite chunk analysis
stats.html
rollup-stats.json

# Component storybook (if added later)
storybook-static/

# Generated type declarations from vite-plugin-dts
src/**/*.d.ts
!src/vite-env.d.ts

# ─── Frontend: src/store & src/components (keep source, ignore generated) ─────
# Never ignore the actual source files — only generated artifacts
src/store/*.generated.js
src/components/*.generated.jsx
